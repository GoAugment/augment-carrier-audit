# Default: reads from the bundled FMCSA parquet snapshot (no key needed).
# Opt-in: set FMCSA_WEBKEY to use the live QCMobile API instead — useful when
# freshness on insurance / OOS status matters more than the parquet-only
# signals (revocations, enforcement history). Get a key at
# https://mobile.fmcsa.dot.gov/QCDevsite/
# FMCSA_WEBKEY=

# Limits
MAX_LOADS_PER_SUBMISSION=1000

# Optional: IP hashing salt (anonymization for service-quality logs)
# IP_HASH_SALT=

# Optional: Slack webhook for lead capture from the "Download the CSV" CTA.
# When set, leads ping the configured channel with email + audit summary.
# Get one at: Slack → Apps → Incoming Webhooks → Add to Workspace.
# SLACK_LEAD_WEBHOOK_URL=

# ============================================================================
# safe@augie.ai email-check pipeline
# ============================================================================
# Required for /api/email/inbound. Without these, the route will 200 to
# SendGrid (so it doesn't retry) but log the missing-key error.

# Anthropic API key — used for Stage 1 LLM extraction (claude-haiku-4-5).
# Get one at https://console.anthropic.com/
# ANTHROPIC_API_KEY=

# SendGrid API key — used for outbound reply emails. Configure with full
# "Mail Send" permission. Get one at SendGrid → Settings → API Keys.
# SENDGRID_API_KEY=

# The From: address replies are sent from. Must match a verified sender
# identity (single sender OR domain-verified) in your SendGrid account.
# SAFE_EMAIL_FROM=safe@augie.ai
