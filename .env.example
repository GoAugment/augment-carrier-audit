# FMCSA QCMobile webKey — required. Get one at https://mobile.fmcsa.dot.gov/QCDevsite/
FMCSA_WEBKEY=

# Risk thresholds (defaults are derived from FMCSA SMS Methodology v3.0.4 P85 framework,
# rounded from a 1,356-carrier industry sample)
THRESHOLD_CRASH_PER_TRUCK=0.20
THRESHOLD_DRIVER_OOS=0.10
THRESHOLD_VEHICLE_OOS=0.40
THRESHOLD_HAZMAT_OOS=0.05

# Limits
MAX_LOADS_PER_SUBMISSION=100

# Vercel KV (auto-injected when Vercel KV is connected to the project)
# KV_URL=
# KV_REST_API_URL=
# KV_REST_API_TOKEN=
# KV_REST_API_READ_ONLY_TOKEN=
