{
  "name": "augment-carrier-audit",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "check:parquet": "node scripts/check_parquet_schema.mjs",
    "check:parquet:clean": "node scripts/check_parquet_schema.mjs --exact",
    "build:single-check-buckets": "node scripts/build_single_check_buckets.mjs --out data/single-check-buckets",
    "build:single-check-compact": "node scripts/build_single_check_compact.mjs --out data/single-check-compact",
    "upload:single-check-buckets": "node scripts/upload_single_check_buckets.mjs --src data/single-check-buckets",
    "upload:single-check-compact": "node scripts/upload_single_check_buckets.mjs --src data/single-check-compact --prefix single-check-compact",
    "test:rules": "tsx --env-file=.env.local scripts/test_rules.ts",
    "test:snapshots": "tsx --env-file=.env.local scripts/snapshot_audit.ts",
    "test": "pnpm check:parquet && pnpm test:rules && pnpm test:snapshots"
  },
  "dependencies": {
    "@google/genai": "^2.4.0",
    "@sendgrid/mail": "^8.1.6",
    "@vercel/blob": "^2.4.0",
    "duckdb": "^1.4.4",
    "next": "14.2.18",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/node": "^20",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "autoprefixer": "^10.4.20",
    "eslint": "^8",
    "eslint-config-next": "14.2.18",
    "playwright": "^1.60.0",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.15",
    "tsx": "^4.22.2",
    "typescript": "^5"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "duckdb",
      "@mapbox/node-pre-gyp"
    ]
  }
}
