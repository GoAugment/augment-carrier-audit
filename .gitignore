# Python bytecode. Matters more than usual here: the refresh workflow commits
# its results with `git add -A`, so without this every automated run drops a
# pile of .pyc files into the data commit.
__pycache__/
*.pyc

# pipeline build artifacts (the committed copy lives at data/)
pipeline/fmcsa-aggregate/*.parquet
pipeline/fmcsa-aggregate/national_thresholds.json
data/single-check-buckets/
data/single-check-compact/
_shot*.mjs

